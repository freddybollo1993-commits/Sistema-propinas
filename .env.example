# Configuración de Base de Datos - Supabase PostgreSQL
# Obtén estas credenciales en Supabase: Settings -> Database -> Connection string -> URI

# Modo Transaction Pooling (Puerto 6543) recomendado para Vercel Serverless:
DATABASE_URL="postgresql://postgres.[TU-PROYECTO]:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Modo Directo (Puerto 5432) para migraciones de Prisma:
DIRECT_URL="postgresql://postgres.[TU-PROYECTO]:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Clave secreta para generación de tokens de sesión JWT
JWT_SECRET="super-secret-jwt-key-cambiar-en-produccion-12345678"

# Nombre del Sistema
NEXT_PUBLIC_APP_NAME="Sistema de Gestión y Registro de Propinas"
